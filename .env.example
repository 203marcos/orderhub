# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
#   cp .env.example .env

# Signing key for JWTs issued by auth-service and validated by api-gateway. Must be the
# same value on both services (docker-compose passes it to each). Generate a strong,
# base64-encoded random value, e.g.:
#
#   openssl rand -base64 48
#
JWT_SECRET=
